    "session.newPlaceBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To a dog, the same cue in a new place is effectively a new task. You go back a little to rebuild it here, and it goes faster than the first time."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla psa ta sama komenda w nowym otoczeniu to w praktyce nowe zadanie. Wracamy kawałek, żeby odbudować ją tutaj — pójdzie szybciej niż za pierwszym razem."
          }
        }
      }
