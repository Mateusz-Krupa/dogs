    "session.easierPlaceBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a simpler setting the dog can handle a harder step. This is not a setback, it is taking one variable away."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W prostszym otoczeniu pies radzi sobie z trudniejszym krokiem. To nie cofnięcie się, tylko jedna zmienna mniej."
          }
        }
      }
    },
    "session.easierPlaceTitle": {
      "localizations": {
