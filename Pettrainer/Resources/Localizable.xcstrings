    "nosework.notScored": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No hits and misses here. Sniffing pays for itself, and scoring it tempts you to help — and the whole value is that the dog works it out alone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nie ma trafień i pudeł. Węszenie nagradza się samo, a ocenianie go kusi, żeby psu pomagać — a cała wartość jest w tym, że rozwiązuje to sam."
          }
        }
      }
    },
    "nosework.setup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przygotowanie"
          }
        }
      }
    },
    "nosework.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not scored — the dog solves this alone"
