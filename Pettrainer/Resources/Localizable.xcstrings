    "problems.sudden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sudden behaviour change in a dog that was fine before — start with the vet. Pain can look like disobedience."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagła zmiana zachowania u psa, któremu wcześniej wszystko było dobrze — zacznij od weterynarza. Ból potrafi wyglądać jak nieposłuszeństwo."
          }
        }
      }
    },
